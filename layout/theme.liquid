<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {% if request.locale.iso_code == 'ar' %}
      <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
      <style>
        body, p, a, h1, h2, h3, h4, h5, h6, .nav-links a, .nav-cta, .col-title, .footer-tagline, .tech-label {
          font-family: 'Cairo', sans-serif !important;
          letter-spacing: 0 !important;
        }
        .lang-switcher { margin-left: 8px; margin-right: 0; }
        .brand-col { padding-left: 40px; padding-right: 0; }
      </style>
    {% endif %}
    
    <!-- Link your custom global CSS here -->
    {{ 'custom-global.css' | asset_url | stylesheet_tag }}
    {{ 'custom-loader.css' | asset_url | stylesheet_tag }}
    
    <!-- GSAP & Lenis for Smooth Scrolling and Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js" defer></script>

    <!-- MANDATORY: Shopify uses this to load apps and analytics -->
    {{ content_for_header }}
  </head>
  
  <body>

    <!-- ═══════════════ LAMBATY LOADER ═══════════════ -->
    <div id="lambaty-loader">
      <div class="loader-ambient-layer">
        <div class="loader-orb orb-c"></div>
        <div class="loader-orb orb-m"></div>
        <div class="loader-orb orb-a"></div>
        <div class="loader-grid-lines"></div>
      </div>

      <div class="loader-centerpiece">
        <div class="loader-energy-ring" id="loader-energy-ring"></div>
        <div class="loader-glass">
          <img
            src="{{ 'White Logo Tag copy.png' | asset_url }}"
            alt="LAMBATY"
            class="loader-logo"
          />
        </div>
      </div>

      <div class="loader-info">
        <div class="loader-status-line">{% if request.locale.iso_code == 'ar' %}تهيئة تجربة LAMBATY{% else %}INITIALIZING LAMBATY EXPERIENCE{% endif %}</div>
        <div class="loader-progress-container">
          <div id="lambaty-loader-bar" class="loader-progress-bar"></div>
        </div>
        <div class="loader-percentage"><span id="lambaty-loader-text">0</span>%</div>
        <div class="loader-boot-text" id="lambaty-loader-boot">{% if request.locale.iso_code == 'ar' %}إقلاع النظام{% else %}SYSTEM BOOT{% endif %}</div>
      </div>
    </div>
    <!-- ═══════════════ END LAMBATY LOADER ═══════════════ -->

    <!-- Your Custom Navbar -->
    {% sections 'header-group' %}
    
    <!-- MANDATORY: This is where your homepage (index.json) renders -->
    <main role="main" tabindex="-1">
      {{ content_for_layout }} 
    </main>
    
    <!-- Your Custom Footer -->
    <!-- Your Custom Footer (Removed default footer group) -->

    <!-- ═══════════════ LAMBATY LOADER JS ═══════════════ -->
    <script>
    (function () {
      var loaderProgress = 0;
      var loaderText  = document.getElementById('lambaty-loader-text');
      var loaderBar   = document.getElementById('lambaty-loader-bar');
      var loader      = document.getElementById('lambaty-loader');
      var loaderBoot  = document.getElementById('lambaty-loader-boot');

      // Tick up to 90 % quickly while page loads
      var loadInterval = setInterval(function () {
        if (loaderProgress < 90) {
          loaderProgress += Math.floor(Math.random() * 8) + 4;
          if (loaderProgress > 90) loaderProgress = 90;
          if (loaderText) loaderText.innerText = loaderProgress;
          if (loaderBar)  loaderBar.style.width  = loaderProgress + '%';
        }
      }, 30);

      window.addEventListener('load', function () {
        clearInterval(loadInterval);
        loaderProgress = 100;
        if (loaderText) loaderText.innerText = loaderProgress;
        if (loaderBar)  loaderBar.style.width  = loaderProgress + '%';

        if (loaderBoot) {
          loaderBoot.style.opacity = 0;
          setTimeout(function () {
            var isAr = "{{ request.locale.iso_code }}" === "ar";
            loaderBoot.innerText    = isAr ? 'التجربة جاهزة' : 'EXPERIENCE READY';
            loaderBoot.style.opacity = 1;
          }, 100);
        }

        // Dismiss with GSAP if available, plain CSS otherwise
        if (loader) {
          loader.classList.add('finishing');
          setTimeout(function () {
            if (typeof gsap !== 'undefined') {
              gsap.to(loader, {
                opacity : 0,
                scale   : 1.05,
                duration: 0.8,
                ease    : 'power2.inOut',
                onComplete: function () {
                  loader.style.display = 'none';
                  document.body.classList.add('hero-loaded');
                }
              });
            } else {
              loader.style.transition = 'opacity 0.8s ease';
              loader.style.opacity    = '0';
              setTimeout(function () {
                loader.style.display = 'none';
                document.body.classList.add('hero-loaded');
              }, 800);
            }
          }, 200);
        } else {
          document.body.classList.add('hero-loaded');
        }
      });
    })();
    </script>
    <!-- ═══════════════ END LAMBATY LOADER JS ═══════════════ -->

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Initialize Lenis for smooth scrolling
        const lenis = new Lenis();

        // Register GSAP ScrollTrigger if it exists
        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger);
          
          lenis.on('scroll', ScrollTrigger.update);

          gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
          });

          gsap.ticker.lagSmoothing(0);
        } else {
          // Fallback if GSAP is not loaded
          function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
          }
          requestAnimationFrame(raf);
        }

        // ── Smooth anchor scroll via Lenis ────────────────
        document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
          anchor.addEventListener('click', function (e) {
            var href = anchor.getAttribute('href');
            if (!href || href === '#') return;
            var target = document.querySelector(href);
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(target, { offset: 0, duration: 1.4, easing: function (t) { return 1 - Math.pow(1 - t, 4); } });
          });
        });
      });
    </script>
  </body>
</html>
