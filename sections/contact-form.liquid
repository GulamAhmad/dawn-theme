{{ 'custom-contact.css' | asset_url | stylesheet_tag }}

<div class="contact-section">
  <!-- Ambient Layer -->
  <div class="contact-ambient">
    <div class="contact-orb orb-c"></div>
    <div class="contact-orb orb-m"></div>
    <div class="contact-grid-lines"></div>
  </div>

  <div class="contact-inner">
    <!-- Left Column: Details -->
    <div class="contact-content">
      <div class="contact-eyebrow">
        <div class="eyebrow-line"></div>
        <span>{% if request.locale.iso_code == 'ar' %}اتصل بنا{% else %}Contact{% endif %}</span>
      </div>

      <h1 class="contact-headline">
        {% if request.locale.iso_code == 'ar' %}نحن هنا للمساعدة{% else %}We're Here to Help{% endif %}
      </h1>

      <p class="contact-description">
        {% if request.locale.iso_code == 'ar' %}
          هل لديك سؤال حول مصباح LAMBATY الخاص بك، أو تحتاج إلى مساعدة بشأن طلب، أو تحتاج إلى دعم في الإعداد أو الاتصال بالتطبيق؟ فريقنا هنا للمساعدة.
        {% else %}
          Have a question about your LAMBATY lamp, need help with an order, or require support with setup or app connection? Our team is here to help.
        {% endif %}
      </p>

      <div class="contact-details">
        <div class="contact-detail-item">
          <span class="contact-detail-label">{% if request.locale.iso_code == 'ar' %}البريد الإلكتروني{% else %}Email{% endif %}</span>
          <a href="mailto:info@lambaty.sa" class="contact-detail-link">info@lambaty.sa</a>
        </div>
        
        <div class="contact-detail-item">
          <span class="contact-detail-label">{% if request.locale.iso_code == 'ar' %}وقت الاستجابة{% else %}Response Time{% endif %}</span>
          <span class="contact-detail-text">
            {% if request.locale.iso_code == 'ar' %}
              نهدف إلى الرد على جميع الاستفسارات خلال 1-2 أيام عمل.
            {% else %}
              We aim to respond to all inquiries within 1-2 business days.
            {% endif %}
          </span>
        </div>

        <div class="contact-detail-item">
          <span class="contact-detail-label">{% if request.locale.iso_code == 'ar' %}مساعدة أسرع{% else %}Faster Assistance{% endif %}</span>
          <span class="contact-detail-text">
            {% if request.locale.iso_code == 'ar' %}
              للحصول على مساعدة أسرع، يرجى تضمين رقم طلبك وأي تفاصيل ذات صلة بسؤالك أو مشكلتك.
            {% else %}
              For faster assistance, please include your order number and any relevant details about your question or issue.
            {% endif %}
          </span>
        </div>
      </div>
    </div>

    <!-- Right Column: Form -->
    <div class="contact-form-wrapper">
      {%- form 'contact', id: 'ContactForm', class: 'custom-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-success-msg">
            {% if request.locale.iso_code == 'ar' %}
              شكرًا لتواصلك مع LAMBATY. تم استلام رسالتك، وسيقوم فريقنا بالرد عليك خلال 1-2 أيام عمل.
            {% else %}
              Thank you for contacting LAMBATY. Your message has been received, and our team will get back to you within 1-2 business days.
            {% endif %}
          </div>
        {%- elsif form.errors -%}
          <div class="form-error-msg">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {%- endif -%}

        <div class="form-row">
          <div class="form-group">
            <label for="ContactForm-name">
              {% if request.locale.iso_code == 'ar' %}الاسم *{% else %}Name *{% endif %}
            </label>
            <input type="text" id="ContactForm-name" name="contact[Name]" required>
          </div>
          <div class="form-group">
            <label for="ContactForm-email">
              {% if request.locale.iso_code == 'ar' %}البريد الإلكتروني *{% else %}Email *{% endif %}
            </label>
            <input type="email" id="ContactForm-email" name="contact[email]" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="ContactForm-order">
              {% if request.locale.iso_code == 'ar' %}رقم الطلب (اختياري){% else %}Order Number (Optional){% endif %}
            </label>
            <input type="text" id="ContactForm-order" name="contact[Order Number]">
          </div>
          <div class="form-group">
            <label for="ContactForm-phone">
              {% if request.locale.iso_code == 'ar' %}رقم الهاتف (اختياري){% else %}Phone Number (Optional){% endif %}
            </label>
            <input type="tel" id="ContactForm-phone" name="contact[Phone Number]">
          </div>
        </div>

        <div class="form-group">
          <label for="ContactForm-reason">
            {% if request.locale.iso_code == 'ar' %}كيف يمكننا المساعدة؟ *{% else %}How Can We Help? *{% endif %}
          </label>
          <select id="ContactForm-reason" name="contact[Reason]" required>
            <option value="" disabled selected>
              {% if request.locale.iso_code == 'ar' %}اختر الخيار المناسب{% else %}Select an option{% endif %}
            </option>
            {% if request.locale.iso_code == 'ar' %}
              <option value="General Question">سؤال عام</option>
              <option value="Order Support">دعم الطلب</option>
              <option value="Shipping & Delivery">الشحن والتوصيل</option>
              <option value="Returns & Refunds">الإرجاع والاسترداد</option>
              <option value="Product Setup">إعداد المنتج</option>
              <option value="App & Connection Support">دعم التطبيق والاتصال</option>
              <option value="Technical Issue">مشكلة فنية</option>
              <option value="Other">أخرى</option>
            {% else %}
              <option value="General Question">General Question</option>
              <option value="Order Support">Order Support</option>
              <option value="Shipping & Delivery">Shipping & Delivery</option>
              <option value="Returns & Refunds">Returns & Refunds</option>
              <option value="Product Setup">Product Setup</option>
              <option value="App & Connection Support">App & Connection Support</option>
              <option value="Technical Issue">Technical Issue</option>
              <option value="Other">Other</option>
            {% endif %}
          </select>
        </div>

        <div class="form-group">
          <label for="ContactForm-body">
            {% if request.locale.iso_code == 'ar' %}الرسالة *{% else %}Message *{% endif %}
          </label>
          <textarea id="ContactForm-body" name="contact[body]" required></textarea>
        </div>

        <button type="submit" class="submit-btn">
          {% if request.locale.iso_code == 'ar' %}إرسال الرسالة{% else %}Send Message{% endif %}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Custom Contact Form"
    }
  ]
}
{% endschema %}
