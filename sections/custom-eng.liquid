{{ 'custom-eng.css' | asset_url | stylesheet_tag }}

<!-- 3.8 Precision Engineered — 6 Damped Joints -->
<section id="engineering" class="eng-section">

  <!-- Ambient background -->
  <div class="eng-bg-grid"></div>
  <div class="eng-ambient orb-cyan"></div>
  <div class="eng-ambient orb-amber"></div>

  <div class="eng-inner">
    <div class="eng-showcase-container">

      <!-- ─── Left Column: Text Content ─────────────────── -->
      <div class="eng-text-content eng-animate">

        <div class="eng-eyebrow-left">
          <span>PREMIUM ENGINEERING</span>
          <div class="eyebrow-line-cyan"></div>
        </div>

        <h2 class="eng-main-headline">6 Damped Joints</h2>

        <p class="eng-main-desc">
          Aviation-grade aluminum alloy arms with strongly damped rotating joints.<br>
          Position it exactly where you need it, and it stays.
        </p>

        <div class="eng-features-list">

          <!-- Feature 1: Smooth & Precise -->
          <div class="eng-feature-item">
            <div class="eng-feature-icon icon-cyan">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <div class="eng-feature-text">
              <h4>Smooth &amp; Precise</h4>
              <p>Strongly damped rotation<br>for perfect positioning.</p>
            </div>
          </div>

          <!-- Feature 2: Built to Last -->
          <div class="eng-feature-item">
            <div class="eng-feature-icon icon-magenta">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div class="eng-feature-text">
              <h4>Built to Last</h4>
              <p>Aviation-grade aluminum<br>for strength and durability.</p>
            </div>
          </div>

          <!-- Feature 3: Stays in Place -->
          <div class="eng-feature-item">
            <div class="eng-feature-icon icon-amber">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </div>
            <div class="eng-feature-text">
              <h4>Stays in Place</h4>
              <p>Engineered damping keeps<br>your setup exactly where<br>you set it.</p>
            </div>
          </div>

        </div>
      </div>
      <!-- ─── End Left Column ──────────────────────────── -->

      <!-- ─── Right Column: Product Image ─────────────── -->
      <div class="eng-image-wrapper eng-animate">
        <div class="eng-image-glow"></div>
        <img
          src="{{ 'Joint-Image-2.png' | asset_url }}"
          alt="Premium Engineering Joints — 6 Damped Rotating Arms"
          class="eng-main-image"
          loading="lazy"
          decoding="async"
        >
      </div>
      <!-- ─── End Right Column ─────────────────────────── -->

    </div>
  </div>
</section>

<script>
(function () {
  'use strict';

  function initEngSection() {
    var section = document.querySelector('.eng-section');
    if (!section) return;

    var animEls = section.querySelectorAll('.eng-animate');

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('eng-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    animEls.forEach(function (el) {
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEngSection);
  } else {
    initEngSection();
  }
})();
</script>

{% schema %}
{
  "name": "6 Damped Joints",
  "presets": [
    {
      "name": "6 Damped Joints",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
