{{ 'custom-focused.css' | asset_url | stylesheet_tag }}

    <!-- 3.5 FOCUSED BRILLIANCE SECTION -->
    <section class="focused" id="productivity">
      <div class="section-inner">
        <!-- LEFT COLUMN - Text & Presets -->
        <div class="text-col">
          <div class="eyebrow-row">
            <div class="focused-eyebrow-line"></div>
            <span class="focused-eyebrow-text">PRODUCTIVITY MODE</span>
          </div>

          <h2 class="focused-headline">
            FOCUSED <span class="focused-hl-amber">BRILLIANCE</span>
          </h2>

          <p class="focused-subtext">
            Switch between warm candlelight and crisp cool white. Perfect
            illumination for reading, deep work, or winding down.
          </p>

          <!-- COLOR TEMPERATURE PRESETS -->
          <div class="presets-container">
            <div class="presets-label">PRESETS</div>
            <div class="presets-grid">
              <button class="preset-btn" data-temp="2700">
                <div
                  class="preset-dot"
                  style="background: #ff9a3c; box-shadow: 0 0 8px #ff9a3c"
                ></div>
                <div class="preset-info">
                  <div class="preset-name">Candlelight</div>
                  <div class="preset-kelvin">2700K</div>
                </div>
              </button>
              <button class="preset-btn active" data-temp="4000">
                <div
                  class="preset-dot"
                  style="background: #ffcf7a; box-shadow: 0 0 8px #ffcf7a"
                ></div>
                <div class="preset-info">
                  <div class="preset-name">Warm White</div>
                  <div class="preset-kelvin">4000K</div>
                </div>
              </button>
              <button class="preset-btn" data-temp="5500">
                <div
                  class="preset-dot"
                  style="background: #fff5e0; box-shadow: 0 0 8px #fff5e0"
                ></div>
                <div class="preset-info">
                  <div class="preset-name">Daylight</div>
                  <div class="preset-kelvin">5500K</div>
                </div>
              </button>
              <button class="preset-btn" data-temp="6500">
                <div
                  class="preset-dot"
                  style="background: #b4dcff; box-shadow: 0 0 8px #b4dcff"
                ></div>
                <div class="preset-info">
                  <div class="preset-name">Cool White</div>
                  <div class="preset-kelvin">6500K</div>
                </div>
              </button>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN - Image Stage -->
        <div class="image-col">
          <div class="image-frame">
            <img
              src="{{ 'white-lamp-1.webp' | asset_url }}"
              alt="White Light Desk Setup"
              id="focused-img"
              loading="lazy"
              decoding="async"
            />
            <div class="temp-label" id="temp-label">4000K — Warm White</div>

            <!-- NEW VERTICAL CONTROLS -->
            <div class="vertical-controls-container">
              <!-- TEMPERATURE -->
              <div class="v-control-group temp-side">
                <div class="v-label-top">TEMP</div>
                <div class="v-track">
                  <div class="v-fill" id="temp-fill"></div>
                  <input type="range" min="2700" max="6500" value="4000" class="v-slider" id="temp-slider" orient="vertical" />
                </div>
                <div class="v-value" id="temp-val-wrap">
                  <svg class="v-icon" viewBox="0 0 24 24" width="16" height="16" style="fill:none; stroke:rgba(255,255,255,0.6); stroke-width:2; stroke-linecap:round; stroke-linejoin:round;">
                    <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
                  </svg>
                  <span id="temp-val">4000K</span>
                </div>
              </div>

              <!-- BRIGHTNESS -->
              <div class="v-control-group bright-side">
                <div class="v-label-top">BRIGHT</div>
                <div class="v-track">
                  <div class="v-fill" id="bright-fill" style="background: #fff;"></div>
                  <input type="range" min="0" max="100" value="80" class="v-slider" id="bright-slider" orient="vertical" />
                </div>
                <div class="v-value" id="bright-val-wrap">
                  <svg class="v-icon" viewBox="0 0 24 24" width="16" height="16" style="fill:none; stroke:rgba(255,255,255,1); stroke-width:2; stroke-linecap:round; stroke-linejoin:round;">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                  </svg>
                  <span id="bright-val">80%</span>
                </div>
              </div>
            </div>

          </div>
        </div>
    </section>
    <!-- END FOCUSED BRILLIANCE SECTION -->


<script>
  document.addEventListener("DOMContentLoaded", () => {
      // --- FOCUSED BRILLIANCE LOGIC ---
      const focusedSection = document.querySelector('.focused');
      if (focusedSection) {
        const tempSliderFocused = document.getElementById('temp-slider');
        const brightSliderFocused = document.getElementById('bright-slider');
        const tempValFocused = document.getElementById('temp-val');
        const brightValFocused = document.getElementById('bright-val');
        const tempThumb = document.getElementById('temp-fill');
        const brightThumb = document.getElementById('bright-fill');
        const focusedImg = document.getElementById('focused-img');
        const tempLabel = document.getElementById('temp-label');
        const presetBtns = document.querySelectorAll('.preset-btn');
        
        // updateAmbient removed

        function updateImageFilter(tempK, brightness) {
          const t = (tempK - 2700) / (6500 - 2700);
          const b = brightness / 100;
          
          const sepia = Math.round((1 - t) * 45); // slightly more sepia
          const saturate = Math.round(90 + t * 30);
          const hueRotate = Math.round(t * 15);
          // Increased brightness range for higher intensity
          const brightnessVal = Math.round(60 + b * 80);
          
          focusedImg.style.filter = `sepia(${sepia}%) saturate(${saturate}%) hue-rotate(${hueRotate}deg) brightness(${brightnessVal}%)`;
        }
        
        function interpolateColor(color1, color2, factor) {
            const result = color1.slice();
            for (let i = 0; i < 3; i++) {
                result[i] = Math.round(result[i] + factor * (color2[i] - color1[i]));
            }
            return result;
        }

        function hexToRgb(hex) {
            const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            return result ? [
                parseInt(result[1], 16),
                parseInt(result[2], 16),
                parseInt(result[3], 16)
            ] : null;
        }
        
        function rgbToHex(r, g, b) {
            return "#" + (1 << 24 | r << 16 | g << 8 | b).toString(16).slice(1);
        }

        function updateFocusedLighting() {
          const temp = parseInt(tempSliderFocused.value);
          const bright = parseInt(brightSliderFocused.value);
          
          tempValFocused.innerText = temp + "K";
          brightValFocused.innerText = bright + "%";
          
          const t = (temp - 2700) / (6500 - 2700);
          
          tempThumb.style.height = `${t * 100}%`;
          brightThumb.style.height = `${bright}%`;
          
          const amber = hexToRgb('#ffb400');
          const white = hexToRgb('#ffffff');
          const blue = hexToRgb('#b4dcff');
          
          let currentColorHex;
          if (t < 0.5) {
              const factor = t / 0.5;
              const rgb = interpolateColor(amber, white, factor);
              currentColorHex = rgbToHex(rgb[0], rgb[1], rgb[2]);
          } else {
              const factor = (t - 0.5) / 0.5;
              const rgb = interpolateColor(white, blue, factor);
              currentColorHex = rgbToHex(rgb[0], rgb[1], rgb[2]);
          }
          
          tempValFocused.style.color = currentColorHex;
          tempLabel.style.color = currentColorHex;
          tempThumb.style.backgroundColor = currentColorHex;
          
          let labelText = "Warm White";
          if (temp <= 3000) labelText = "Candlelight";
          else if (temp > 3000 && temp <= 4500) labelText = "Warm White";
          else if (temp > 4500 && temp <= 5800) labelText = "Daylight";
          else labelText = "Cool White";
          
          tempLabel.innerText = `${temp}K — ${labelText}`;
          
          updateImageFilter(temp, bright);
          
          presetBtns.forEach(btn => {
              if (parseInt(btn.dataset.temp) === temp) {
                  btn.classList.add('active');
              } else {
                  btn.classList.remove('active');
              }
          });
        }

        // rAF-throttle slider updates to prevent dozens of expensive recalcs/sec on mobile
        let focusedRafPending = false;
        function throttledUpdateFocusedLighting() {
          if (focusedRafPending) return;
          focusedRafPending = true;
          requestAnimationFrame(() => {
            updateFocusedLighting();
            focusedRafPending = false;
          });
        }

        tempSliderFocused.addEventListener('input', throttledUpdateFocusedLighting);
        brightSliderFocused.addEventListener('input', throttledUpdateFocusedLighting);

        presetBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const temp = btn.dataset.temp;
                tempSliderFocused.value = temp;
                updateFocusedLighting();
            });
        });

        updateFocusedLighting();

        const focusedObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.05 });

        focusedObserver.observe(focusedSection);
      }
      // --- END FOCUSED BRILLIANCE LOGIC ---

  });
</script>

{% schema %}
{
  "name": "Focused Brilliance",
  "presets": [
    {
      "name": "Focused Brilliance",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
