{{ 'custom-footer.css' | asset_url | stylesheet_tag }}

<!-- PREMIUM FOOTER -->
<footer class="premium-footer">

  <!-- Ambient Background -->
  <div class="footer-ambient">
    <div class="footer-orb orb-c"></div>
    <div class="footer-orb orb-m"></div>
    <div class="footer-orb orb-a"></div>
    <div class="footer-grid-lines"></div>
  </div>

  <div class="footer-content">

    <!-- Main Grid -->
    <div class="footer-grid">

      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link">
          <img src="{{ 'White Logo Tag copy.png' | asset_url }}" alt="LAMBATY" class="footer-logo-img" />
        </a>
        <p class="footer-tagline">Illuminate Your Universe.</p>
      </div>

      <!-- Explore Column -->
      <div class="footer-col">
        <h4 class="col-title">Explore</h4>
        <ul class="footer-links">
          <li><a href="#stats-section">RGB Experience</a></li>
          <li><a href="#productivity">Productivity</a></li>
          <li><a href="#engineering">Engineering</a></li>
          <li><a href="#socials">Community</a></li>
        </ul>
      </div>

      <!-- Support Column -->
      <div class="footer-col">
        <h4 class="col-title">Support</h4>
        <ul class="footer-links">
          <li><a href="{{ section.settings.faq_url | default: '#' }}">FAQs</a></li>
          <li><a href="{{ section.settings.warranty_url | default: '#' }}">Warranty</a></li>
          <li><a href="{{ section.settings.contact_url | default: '#' }}">Contact</a></li>
          <li><a href="{{ section.settings.shipping_url | default: '#' }}">Shipping</a></li>
        </ul>
      </div>

      <!-- Connect / Socials Column -->
      <div class="footer-col">
        <h4 class="col-title">Connect</h4>
        <div class="footer-social-links">

          <!-- Instagram -->
          {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="footer-social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
          {%- else -%}
          <a href="#" class="footer-social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
          {%- endif -%}

          <!-- TikTok -->
          {%- if section.settings.tiktok_url != blank -%}
          <a href="{{ section.settings.tiktok_url }}" class="footer-social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
            <span>TikTok</span>
          </a>
          {%- else -%}
          <a href="#" class="footer-social-link" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
            <span>TikTok</span>
          </a>
          {%- endif -%}

          <!-- YouTube -->
          {%- if section.settings.youtube_url != blank -%}
          <a href="{{ section.settings.youtube_url }}" class="footer-social-link" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
            <span>YouTube</span>
          </a>
          {%- else -%}
          <a href="#" class="footer-social-link" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
            <span>YouTube</span>
          </a>
          {%- endif -%}

        </div>
      </div>

    </div>
    <!-- End Main Grid -->

    <!-- Technical Labels -->
    <div class="footer-tech-labels">
      <div class="tech-label">
        SYSTEM STATUS: <span class="pf-status-indicator"></span> ONLINE
      </div>
      <div class="tech-label">
        GENERATION: GEN II — {{ 'now' | date: '%Y' }}
      </div>
      <div class="tech-label">DESIGNED IN: EARTH // DIGITAL FIRST</div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <span>&copy; {{ 'now' | date: '%Y' }} LAMBATY</span>
        <span class="bottom-separator"></span>
        <span>Built for creators, gamers, and modern workspaces.</span>
      </div>
      <div class="bottom-right">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
        {%- if shop.policies.size == 0 -%}
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="#">Support</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Premium Footer",
  "settings": [
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Support Links"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQs URL"
    },
    {
      "type": "url",
      "id": "warranty_url",
      "label": "Warranty URL"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    },
    {
      "type": "url",
      "id": "shipping_url",
      "label": "Shipping URL"
    }
  ],
  "presets": [
    {
      "name": "Premium Footer",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
