{{ 'custom-footer.css' | asset_url | stylesheet_tag }}

<!-- PREMIUM FOOTER -->
<footer class="premium-footer">

  <!-- Ambient Background -->
  <div class="footer-ambient">
    <div class="footer-watermark">LAMBATY</div>
    <div class="footer-orb orb-c"></div>
    <div class="footer-orb orb-m"></div>
    <div class="footer-orb orb-a"></div>
    <div class="footer-grid-lines"></div>
  </div>

  <div class="footer-content">

    <!-- Main Grid -->
    <div class="footer-grid">

      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link">
          <img src="{{ 'White Logo Tag copy.png' | asset_url }}" alt="LAMBATY" class="footer-logo-img" />
        </a>
        <p class="footer-tagline">{% if request.locale.iso_code == 'ar' %}أضئ عالمك.{% else %}Illuminate Your Universe.{% endif %}</p>
      </div>

      <!-- Support Column -->
      <div class="footer-col">
        <h4 class="col-title">{% if request.locale.iso_code == 'ar' %}الدعم{% else %}Support{% endif %}</h4>
        <ul class="footer-links">
          <li><a href="{{ section.settings.faq_url | default: '/pages/faq' }}">{% if request.locale.iso_code == 'ar' %}الأسئلة الشائعة{% else %}FAQs{% endif %}</a></li>
          <li><a href="{{ section.settings.contact_url | default: '/pages/contact' }}">{% if request.locale.iso_code == 'ar' %}اتصل بنا{% else %}Contact{% endif %}</a></li>
          <li><a href="{{ section.settings.shipping_url | default: '/pages/shipping-policy' }}">{% if request.locale.iso_code == 'ar' %}الشحن{% else %}Shipping Policy{% endif %}</a></li>
          <li><a href="{{ section.settings.returns_url | default: '/pages/returns-refund-policy' }}">{% if request.locale.iso_code == 'ar' %}سياسة الإرجاع والاسترداد{% else %}Returns / Refund Policy{% endif %}</a></li>
          <li><a href="/pages/privacy-policy">{% if request.locale.iso_code == 'ar' %}سياسة الخصوصية{% else %}Privacy Policy{% endif %}</a></li>
          <li><a href="/pages/terms-of-service">{% if request.locale.iso_code == 'ar' %}شروط الخدمة{% else %}Terms of Service{% endif %}</a></li>
        </ul>
      </div>

      <!-- Connect / Socials Column -->
      <div class="footer-col">
        <h4 class="col-title st">{% if request.locale.iso_code == 'ar' %}تواصل معنا{% else %}Connect{% endif %}</h4>
        <div class="footer-social-links">

          <!-- Instagram -->
          <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/lambaty.sa/' }}" class="footer-social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>

          <!-- TikTok -->
          <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/@lambaty.sa' }}" class="footer-social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
            <span>TikTok</span>
          </a>

        </div>
      </div>

    </div>
    <!-- End Main Grid -->

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <span>&copy; {{ 'now' | date: '%Y' }} LAMBATY</span>
        <span class="bottom-separator"></span>
        <span>{% if request.locale.iso_code == 'ar' %}صُمم للمبدعين، واللاعبين، ومساحات العمل الحديثة.{% else %}Built for creators, gamers, and modern workspaces.{% endif %}</span>
      </div>
      <div class="bottom-right">
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Premium Footer",
  "settings": [
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Support Links"
    },
    {
      "type": "url",
      "id": "faq_url",
      "label": "FAQs URL"
    },
    {
      "type": "url",
      "id": "returns_url",
      "label": "Returns URL"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    },
    {
      "type": "url",
      "id": "shipping_url",
      "label": "Shipping URL"
    }
  ],
  "presets": [
    {
      "name": "Premium Footer",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
