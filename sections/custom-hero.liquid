{{ 'custom-hero.css' | asset_url | stylesheet_tag }}

<!-- NEW HERO SECTION REPLICATION -->
<div id="rgb" class="hero-wrapper hero-loaded">
  <!-- AMBIENT LAYER -->
  <div class="ambient-layer">
    <div class="orb orb-cyan"></div>
    <div class="orb orb-magenta"></div>
    <div class="orb orb-amber"></div>
    <div class="grid-lines"></div>
  </div>

  <!-- HERO BODY -->
  <section class="hero-section">
    <!-- Left Column -->
    <div class="hero-left">
      <div class="eyebrow-row">
        <div class="eyebrow-line"></div>
        <span class="eyebrow-text">
          {% if request.locale.iso_code == 'ar' %}
            إضاءة مزدوجة الجوانب · مصباح مكتب ذكي بألوان RGB
          {% else %}
            Dual-sided illumination · RGB Smart Desk Lamp
          {% endif %}
        </span>
      </div>

      <h1 class="hero-headline">
        <div class="headline-line1">
          {% if request.locale.iso_code == 'ar' %}
            يلتقي الجو مع
          {% else %}
            ATMOSPHERE MEETS
          {% endif %}
        </div>
        <div class="headline-line2">
          {% if request.locale.iso_code == 'ar' %}
            <span class="hl-univer">التحكم</span>
          {% else %}
            <span class="hl-univer">CONTR</span><span class="hl-s">O</span><span class="hl-e">L</span>
          {% endif %}
        </div>
      </h1>

      <p class="hero-subtext">
        {% if request.locale.iso_code == 'ar' %}
          إضاءة RGB غامرة. <span class="bold-white">إنتاجية دافئة.</span> محركا إضاءة مستقلان — أحدهما للجو العام،
          والآخر للعمل. مصباح المكتب الوحيد الذي ستحتاجه.
        {% else %}
          Immersive RGB.
          <span class="bold-white">Warm productivity.</span> Two independent light engines — one for the ambience, one
          for the work. The only desk lamp you'll ever need.
        {% endif %}
      </p>

      <div class="cta-row">
        <button class="primary-btn" onclick="openVideoModal()">
          <div
            class="play-circle"
            style="background: rgba(255,255,255,0.2); margin-right: 8px; margin-left: {% if request.locale.iso_code == 'ar' %}8px{% else %}0{% endif %}; {% if request.locale.iso_code == 'ar' %}margin-right: 0;{% endif %}"
          >
            <svg width="8" height="10" viewBox="0 0 8 10" fill="currentColor">
              <path d="M0 0L8 5L0 10V0Z" />
            </svg>
          </div>
          {% if request.locale.iso_code == 'ar' %}شاهدها وهي تعمل{% else %}See it in action{% endif %}
        </button>
      </div>
    </div>

    <!-- Right Column -->
    <div class="hero-right">
      <div class="vignette"></div>
      <div class="outer-ring"></div>
      <div class="inner-ring"></div>
      <img src="{{ 'rgb1.png' | asset_url }}" alt="Lambaty Smart Lamp" class="product-image" />

      <div class="glass-chip chip-1">
        <div class="chip-dot dot-cyan"></div>
        {% if request.locale.iso_code == 'ar' %}وضع RGB نشط{% else %}RGB Mode Active{% endif %}
      </div>
      <div class="glass-chip chip-2">
        <div class="chip-dot dot-amber"></div>
        {% if request.locale.iso_code == 'ar' %}4000K أبيض دافئ{% else %}4000K Warm White{% endif %}
      </div>
      <div class="glass-chip chip-3">
        <div class="chip-dot dot-magenta"></div>
        {% if request.locale.iso_code == 'ar' %}إضاءة انحيازية قيد التشغيل{% else %}Bias Lighting On{% endif %}
      </div>
    </div>

    <!-- Bottom Elements -->
    <div class="scroll-cue">
      <div class="scroll-line"></div>
      <span>
        {%- if request.locale.iso_code == 'ar' %}مرر للاستكشاف{% else %}Scroll to explore{% endif -%}
      </span>
    </div>

    <div class="version-badge">
      {% if request.locale.iso_code == 'ar' %}
        الجيل الثاني — <span class="current-year">2025</span>
      {% else %}
        Gen II — <span class="current-year">2025</span>
      {% endif %}
    </div>
  </section>
</div>

<!-- Video Modal -->
<div id="videoModal" class="video-modal-overlay" onclick="closeVideoModal(event)">
  <div class="video-modal-content">
    <button class="video-modal-close" onclick="closeVideoModal(event, true)">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <video id="heroVideo" controls playsinline>
      {% if request.locale.iso_code == 'ar' %}
        <source src="{{ 'v2 (1).mp4' | file_url }}" type="video/mp4">
      {% else %}
        <source src="{{ 'v1 (1).mp4' | file_url }}" type="video/mp4">
      {% endif %}
      Your browser does not support the video tag.
    </video>
  </div>
</div>

<script>
  function openVideoModal() {
    document.getElementById('videoModal').style.display = 'flex';
    setTimeout(() => {
      document.getElementById('videoModal').classList.add('active');
      document.getElementById('heroVideo').play();
    }, 10);
  }

  function closeVideoModal(event, forceClose) {
    if (forceClose || event.target.id === 'videoModal') {
      document.getElementById('videoModal').classList.remove('active');
      setTimeout(() => {
        document.getElementById('videoModal').style.display = 'none';
        document.getElementById('heroVideo').pause();
        document.getElementById('heroVideo').currentTime = 0;
      }, 300); // match transition duration
    }
  }
</script>
<!-- END NEW HERO SECTION REPLICATION -->

{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button Link",
      "info": "Where should the 'Pre-order now' button go?"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
