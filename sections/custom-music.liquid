{{ 'custom-music.css' | asset_url | stylesheet_tag }}

<!-- BEAT SYNC SECTION -->
<div id="music" class="beat-section">
  <!-- AMBIENT LAYER -->
  <div class="ambient-layer">
    <div class="beat-orb orb-magenta"></div>
    <div class="beat-orb orb-cyan"></div>
    <div class="beat-orb orb-purple"></div>
    <div class="beat-orb orb-amber"></div>
    <div class="grid-lines"></div>
  </div>

  <div class="section-inner">
    <!-- LEFT COLUMN: Image Stage -->
    <div class="image-col">
      <div class="glow-disc"></div>
      <div class="beat-decorative-ring"></div>

      <div class="image-frame">
        <img src="{{ 'setup1.webp' | asset_url }}" alt="Music Sync Setup" loading="lazy" decoding="async" />
        <div class="beat-overlay"></div>
      </div>

      <div class="mic-chip">
        <div class="mic-icon">
          <div class="mic-bar"></div>
          <div class="mic-bar"></div>
          <div class="mic-bar"></div>
        </div>
        MIC SYNC ACTIVE
      </div>
    </div>

    <!-- RIGHT COLUMN: Copy + Soundwave -->
    <div class="copy-col">
      <div class="eyebrow-row">
        <div class="beat-eyebrow-line"></div>
        <span class="beat-eyebrow-text">MUSIC SYNC TECHNOLOGY</span>
      </div>

      <h2 class="beat-headline">
        FEEL THE <span class="beat-hl-magenta">BEAT</span>
      </h2>

      <p class="beat-subtext">
        Built-in high-sensitivity microphones sync the ambient lighting to
        your music in real-time.
      </p>

      <div class="feature-pills">
        <div class="pill">Real-time Sync</div>
        <div class="pill">Audio Reactive</div>
        <div class="pill">Auto Calibrate</div>
      </div>

      <div class="soundwave">
        <!-- Bars will be generated by JS -->
      </div>
      <div class="wave-baseline"></div>

      <div class="wave-labels">
        <span class="label-freq">FREQ</span>
        <span class="label-sync"><div class="sync-dot"></div> SYNC ACTIVE</span>
      </div>
    </div>
  </div>
</div>
<!-- END BEAT SYNC SECTION -->

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const beatSection = document.getElementById('music');
    if (!beatSection) return;

    // --- FEEL THE BEAT SOUNDWAVE GENERATION ---
    const soundwaveContainer = beatSection.querySelector('.soundwave');
    if (soundwaveContainer) {
      soundwaveContainer.innerHTML = ''; // Clear any existing
      // Create a high-DPI canvas to replace the heavy DOM nodes
      const canvas = document.createElement('canvas');
      const dpr = window.devicePixelRatio || 1;
      const logicalWidth = 480;
      const logicalHeight = 120;
      
      canvas.width = logicalWidth * dpr;
      canvas.height = logicalHeight * dpr;
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      canvas.style.maxWidth = '480px';
      canvas.style.maxHeight = '120px';
      soundwaveContainer.appendChild(canvas);
      
      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const totalBars = 48;
      const gap = 4;
      const actualBarWidth = (logicalWidth - (totalBars - 1) * gap) / totalBars;

      const barsData = [];
      for (let i = 0; i < totalBars; i++) {
        const center = Math.sin((i / totalBars) * Math.PI);
        const baseHeight = 15 + center * 55;
        
        let color = "";
        if (i < 16) {
          color = "#ff1478";
        } else if (i < 32) {
          const progress = (i - 16) / 15;
          const r = Math.round(255 - (255 - 0) * progress);
          const g = Math.round(20 + (230 - 20) * progress);
          const b = Math.round(120 + (210 - 120) * progress);
          color = `rgba(${r},${g},${b},0.8)`;
        } else {
          color = "#00e6d2";
        }
        
        barsData.push({ baseHeight, color });
      }

      let beatPhase = 0;
      let time = 0;
      window.isAnimatingBars = false;
      window.beatPulse = 1.0;

      window.animateBars = function() {
        if (!window.isAnimatingBars) return;

        time += 0.04;
        beatPhase += 0.06;
        
        // Clear canvas for the new frame
        ctx.clearRect(0, 0, logicalWidth, logicalHeight);
        
        for (let i = 0; i < totalBars; i++) {
          const data = barsData[i];
          const wave1 = Math.sin(time * 2.1 + i * 0.4) * 0.35;
          const wave2 = Math.sin(time * 3.7 + i * 0.7) * 0.20;
          const wave3 = Math.sin(time * 1.3 + i * 0.2) * 0.15;
          const beat = Math.abs(Math.sin(beatPhase)) * 0.30;
          
          const multiplier = 1 + wave1 + wave2 + wave3 + beat;
          const currentHeight = Math.max(4, data.baseHeight * multiplier * window.beatPulse);
          
          const x = i * (actualBarWidth + gap);
          const y = logicalHeight - currentHeight; // draw from bottom up
          
          ctx.fillStyle = data.color;
          
          ctx.beginPath();
          if (ctx.roundRect) {
            ctx.roundRect(x, y, actualBarWidth, currentHeight, [2, 2, 0, 0]);
          } else {
            ctx.rect(x, y, actualBarWidth, currentHeight);
          }
          ctx.fill();
        }
        
        requestAnimationFrame(window.animateBars);
      }
    }
    // --- END FEEL THE BEAT SOUNDWAVE GENERATION ---

    // --- FEEL THE BEAT SYNC JS ---
    const beatColors = [
      'rgba(0,230,210,0.3)',    // cyan
      'rgba(255,20,120,0.3)',   // magenta
      'rgba(255,180,0,0.25)',   // amber
    ];
    let colorIndex = 0;
    let beatActive = false;

    function triggerBeat() {
      if (!beatActive) return;
      
      const overlay = beatSection.querySelector('.beat-overlay');
      const frame = beatSection.querySelector('.image-frame');
      const glowDisc = beatSection.querySelector('.glow-disc');
      
      const currentColor = beatColors[colorIndex % beatColors.length];
      
      if (overlay) {
        overlay.style.background = currentColor;
        overlay.style.opacity = '1';
      }
      
      if (frame) {
        const brightColor = currentColor.replace('0.3', '0.4').replace('0.25', '0.35');
        frame.style.boxShadow = `0 0 0 1px ${brightColor}, 0 0 80px ${currentColor}, 0 20px 80px rgba(0,0,0,0.6)`;
      }
      
      if (glowDisc) {
          glowDisc.style.background = `radial-gradient(circle, ${currentColor} 0%, transparent 65%)`;
      }
      
      window.beatPulse = 1.3;
      colorIndex++;
      
      setTimeout(() => {
        if (overlay) overlay.style.opacity = '0';
        if (frame) frame.style.boxShadow = '0 0 0 1px rgba(255,20,120,0.15), 0 0 40px rgba(255,20,120,0.08), 0 20px 80px rgba(0,0,0,0.6)';
        if (glowDisc) glowDisc.style.background = 'radial-gradient(circle, rgba(255,20,120,0.08) 0%, transparent 65%)';
        window.beatPulse = 1.0;
      }, 180);
      
      const nextBeat = 500 + Math.random() * 200;
      setTimeout(triggerBeat, nextBeat);
    }

    // Start after section enters viewport
    const beatObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          if (!beatActive) {
              beatActive = true;
              triggerBeat();
          }
          if (!window.isAnimatingBars) {
              window.isAnimatingBars = true;
              if (window.animateBars) window.animateBars();
          }
        } else {
           // Pause off-screen rendering
           window.isAnimatingBars = false;
           beatActive = false;
        }
      });
    }, { threshold: 0.15 });

    beatObserver.observe(beatSection);
    // --- END FEEL THE BEAT SYNC JS ---
  });
</script>

{% schema %}
{
  "name": "Custom Music Beat",
  "presets": [
    {
      "name": "Custom Music Beat",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
