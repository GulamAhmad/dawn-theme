{{ 'custom-real-spaces.css' | asset_url | stylesheet_tag }}

<!-- 3.10 Seen in Real Spaces -->
<section id="socials" class="real-spaces-section">

  <!-- Ambient Layer -->
  <div class="rs-ambient">
    <div class="rs-orb rs-orb-cyan"></div>
    <div class="rs-orb rs-orb-magenta"></div>
    <div class="rs-grid-lines"></div>
  </div>

  <!-- Section Header -->
  <div class="rs-header">
    <div class="rs-eyebrow">
      <div class="rs-eyebrow-line"></div>
      <span>COMMUNITY SHOWCASE</span>
      <div class="rs-eyebrow-line"></div>
    </div>
    <h2 class="rs-headline">
      SEEN IN <span class="rs-hl">REAL SPACES</span>
    </h2>
    <p class="rs-subtext">
      Discover how creators, gamers, and professionals illuminate their environments with LAMBATY.
    </p>
  </div>

  <!-- Reel Container -->
  <div class="reel-container" id="rs-reel-container">

    <!-- Reel 1 -->
    <div class="reel-card rs-animate" data-index="0">
      <div class="reel-card-placeholder">
        <div class="reel-placeholder-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
          </svg>
        </div>
      </div>
      <video
        class="reel-video"
        src="{{ section.settings.reel_1_video }}"
        muted
        loop
        playsinline
        preload="none"
      ></video>
      <div class="reel-overlay"></div>
      <div class="reel-info">
        <div class="reel-badge">FEATURED SETUP</div>
        <h3 class="reel-creator">{{ section.settings.reel_1_creator | default: 'ALEX W.' }}</h3>
        <div class="reel-env">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          {{ section.settings.reel_1_env | default: 'Gaming Studio' }}
        </div>
        <div class="reel-tags">
          <span class="rs-tag">RGB Mode</span>
          <span class="rs-tag">Music Sync</span>
        </div>
      </div>
    </div>

    <!-- Reel 2 -->
    <div class="reel-card rs-animate" data-index="1">
      <div class="reel-card-placeholder">
        <div class="reel-placeholder-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
      </div>
      <video
        class="reel-video"
        src="{{ section.settings.reel_2_video }}"
        muted
        loop
        playsinline
        preload="none"
      ></video>
      <div class="reel-overlay"></div>
      <div class="reel-info">
        <div class="reel-badge">CREATOR SERIES</div>
        <h3 class="reel-creator">{{ section.settings.reel_2_creator | default: 'SARAH JENKINS' }}</h3>
        <div class="reel-env">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
