{{ 'custom-real-spaces.css' | asset_url | stylesheet_tag }}

<!-- 3.10 Seen in Real Spaces -->
<section id="socials" class="real-spaces-section">

  <!-- Ambient Layer -->
  <div class="rs-ambient">
    <div class="rs-orb rs-orb-cyan"></div>
    <div class="rs-orb rs-orb-magenta"></div>
    <div class="rs-grid-lines"></div>
  </div>

  <!-- Section Header -->
  <div class="rs-header">
    <div class="rs-eyebrow">
      <div class="rs-eyebrow-line"></div>
      <span>{% if request.locale.iso_code == 'ar' %}عرض المجتمع{% else %}COMMUNITY SHOWCASE{% endif %}</span>
      <div class="rs-eyebrow-line"></div>
    </div>
    <h2 class="rs-headline">
      {% if request.locale.iso_code == 'ar' %}رؤيتنا في <span class="rs-hl">مساحات حقيقية</span>{% else %}SEEN IN <span class="rs-hl">REAL SPACES</span>{% endif %}
    </h2>
    <p class="rs-subtext">
      {% if request.locale.iso_code == 'ar' %}اكتشف كيف يضيء المبدعون واللاعبون والمحترفون بيئاتهم باستخدام LAMBATY.{% else %}Discover how creators, gamers, and professionals illuminate their environments with LAMBATY.{% endif %}
    </p>
  </div>

  <!-- Reel Container -->
  <div class="reel-container" id="rs-reel-container">

    <!-- Reel 1 -->
    <div class="reel-card rs-animate" data-index="0">
      <div class="reel-card-placeholder">
        <div class="reel-placeholder-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="23 7 16 12 23 17 23 7"></polygon>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
          </svg>
        </div>
      </div>
      <video
        class="reel-video"
        src="{% if section.settings.reel_1_video != blank %}{{ section.settings.reel_1_video }}{% else %}{{ 'Reel 1.mp4' | file_url }}{% endif %}"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <div class="reel-overlay"></div>
      <div class="reel-info">
        <h3 class="reel-creator">{% if request.locale.iso_code == 'ar' %}إعداد الألعاب{% else %}{{ section.settings.reel_1_title | default: 'Gaming Setup' }}{% endif %}</h3>
        <div class="reel-tags">
          <span class="rs-tag">RGB MODE</span>
          <span class="rs-tag">DYNAMIC MODES</span>
        </div>
      </div>
    </div>

    <!-- Reel 2 -->
    <div class="reel-card rs-animate" data-index="1">
      <div class="reel-card-placeholder">
        <div class="reel-placeholder-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
      </div>
      <video
        class="reel-video"
        src="{% if section.settings.reel_2_video != blank %}{{ section.settings.reel_2_video }}{% else %}{{ 'Reel 2.mp4' | file_url }}{% endif %}"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <div class="reel-overlay"></div>
      <div class="reel-info">
        <h3 class="reel-creator">{% if request.locale.iso_code == 'ar' %}مكتب بسيط{% else %}{{ section.settings.reel_2_title | default: 'Minimal Desk' }}{% endif %}</h3>
        <div class="reel-tags">
          <span class="rs-tag">AMBIENT LIGHTING</span>
          <span class="rs-tag">APP CONTROL</span>
        </div>
      </div>
    </div>

    <!-- Reel 3 -->
    <div class="reel-card rs-animate" data-index="2">
      <div class="reel-card-placeholder">
        <div class="reel-placeholder-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20"></path>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        </div>
      </div>
      <video
        class="reel-video"
        src="{% if section.settings.reel_3_video != blank %}{{ section.settings.reel_3_video }}{% else %}{{ 'Reel 3.mp4' | file_url }}{% endif %}"
        muted
        loop
        playsinline
        autoplay
      ></video>
      <div class="reel-overlay"></div>
      <div class="reel-info">
        <h3 class="reel-creator">{% if request.locale.iso_code == 'ar' %}إعداد الإنتاجية{% else %}{{ section.settings.reel_3_title | default: 'Productivity Setup' }}{% endif %}</h3>
        <div class="reel-tags">
          <span class="rs-tag">WARM WHITE</span>
          <span class="rs-tag">COOL WHITE</span>
        </div>
      </div>
    </div>



  </div>
  <!-- End Reel Container -->


</section>

<script>
(function () {
  'use strict';

  function initRealSpaces() {
    var container = document.getElementById('rs-reel-container');
    var cards     = document.querySelectorAll('.reel-card');

    if (!container) return;

    // ── Card entrance animation ───────────────────────────
    var animCards = document.querySelectorAll('.rs-animate');
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('rs-visible');
          }
        });
      }, { threshold: 0.1 });
      animCards.forEach(function (card) { observer.observe(card); });
    } else {
      animCards.forEach(function (card) { card.classList.add('rs-visible'); });
    }

    // Videos autoplay via HTML attribute
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRealSpaces);
  } else {
    initRealSpaces();
  }
})();
</script>

{% schema %}
{
  "name": "Seen in Real Spaces",
  "settings": [
    {
      "type": "header",
      "content": "Reel 1"
    },
    {
      "type": "text",
      "id": "reel_1_title",
      "label": "Title",
      "default": "Gaming Setup"
    },
    {
      "type": "url",
      "id": "reel_1_video",
      "label": "Video URL (MP4)"
    },
    {
      "type": "header",
      "content": "Reel 2"
    },
    {
      "type": "text",
      "id": "reel_2_title",
      "label": "Title",
      "default": "Minimal Desk"
    },
    {
      "type": "url",
      "id": "reel_2_video",
      "label": "Video URL (MP4)"
    },
    {
      "type": "header",
      "content": "Reel 3"
    },
    {
      "type": "text",
      "id": "reel_3_title",
      "label": "Title",
      "default": "Productivity Setup"
    },
    {
      "type": "url",
      "id": "reel_3_video",
      "label": "Video URL (MP4)"
    }
  ],
  "presets": [
    {
      "name": "Seen in Real Spaces",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
