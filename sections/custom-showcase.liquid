{{ 'custom-showcase.css' | asset_url | stylesheet_tag }}

<!-- 3.7 Cinematic Showcase (Horizontal Scroll) -->
<section id="usecases" class="showcase-section">
  <div class="pin-container">
    <div class="pin-wrap">

      <!-- Panel 1: Gaming Setup -->
      <div class="showcase-panel">
        <div class="showcase-bg">
          <div class="showcase-orb orb-rgb-m" data-speed="0.8"></div>
          <div class="showcase-grid-lines"></div>
        </div>
        <div class="showcase-content">
          <div class="showcase-text-content" data-speed="1.15">
            <div class="showcase-eyebrow">
              <div class="eyebrow-line"></div>
              <span>{% if request.locale.iso_code == 'ar' %}إعداد الألعاب{% else %}GAMING SETUP{% endif %}</span>
            </div>
            <h3 class="showcase-headline">
              {% if request.locale.iso_code == 'ar' %}
                مصمم لإعدادات
                <span class="text-brand-magenta">غامرة</span>.
              {% else %}
                BUILT FOR
                <span class="text-brand-magenta">IMMERSIVE</span> SETUPS.
              {% endif %}
            </h3>
          </div>
          <div class="showcase-visual dual-image" data-speed="0.95">
            <div class="img-wrapper main-img" data-speed="0.9">
              <img
                src="{{ 'setup1.webp' | asset_url }}"
                alt="Gaming Setup 1"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="img-wrapper sub-img" data-speed="1.2">
              <img
                src="{{ 'setup2.webp' | asset_url }}"
                alt="Gaming Setup 2"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 2: Home Office Setup -->
      <div class="showcase-panel">
        <div class="showcase-bg">
          <div class="showcase-orb orb-warm" data-speed="0.85"></div>
          <div class="showcase-grid-lines"></div>
        </div>
        <div class="showcase-content reverse">
          <div class="showcase-text-content" data-speed="1.1">
            <div class="showcase-eyebrow">
              <div class="eyebrow-line"></div>
              <span>{% if request.locale.iso_code == 'ar' %}إعداد المكتب المنزلي{% else %}HOME OFFICE SETUP{% endif %}</span>
            </div>
            <h3 class="showcase-headline">
              {% if request.locale.iso_code == 'ar' %}
                مكتب أنظف. <br /><span class="text-amber-500">سير عمل أهدأ.</span>
              {% else %}
                A CLEANER DESK. <br /><span class="text-amber-500">A CALMER WORKFLOW.</span>
              {% endif %}
            </h3>
          </div>
          <div class="showcase-visual dual-image" data-speed="0.92">
            <div class="img-wrapper main-img" data-speed="0.85">
              <img
                src="{{ 'White-Light-Desk-Set-up-copy.webp' | asset_url }}"
                alt="Home Office 1"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="img-wrapper sub-img" data-speed="1.15">
              <img
                src="{{ 'Colored-Desk-Set-Up-2-copy.webp' | asset_url }}"
                alt="Home Office 2"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 3: Bedroom Setup -->
      <div class="showcase-panel">
        <div class="showcase-bg">
          <div class="showcase-orb orb-neutral" data-speed="0.9"></div>
          <div class="showcase-grid-lines"></div>
        </div>
        <div class="showcase-content">
          <div class="showcase-text-content" data-speed="1.2">
            <div class="showcase-eyebrow">
              <div class="eyebrow-line"></div>
              <span>{% if request.locale.iso_code == 'ar' %}إعداد غرفة النوم{% else %}BEDROOM SETUP{% endif %}</span>
            </div>
            <h3 class="showcase-headline">
              {% if request.locale.iso_code == 'ar' %}
                إضاءة أنعم للساعات <span class="text-white">الهادئة.</span>
              {% else %}
                SOFTER LIGHT FOR <span class="text-white">SLOWER HOURS.</span>
              {% endif %}
            </h3>
          </div>
          <div class="showcase-visual dual-image" data-speed="0.95">
            <div class="img-wrapper main-img" data-speed="0.9">
              <img
                src="{{ 'White-Light-Bed-Set-Up-2-copy.webp' | asset_url }}"
                alt="Bedroom Setup 1"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="img-wrapper sub-img" data-speed="1.25">
              <img
                src="{{ 'Colored-Bed-Set-Up-2-copy.webp' | asset_url }}"
                alt="Bedroom Setup 2"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function initShowcase() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initShowcase, 300);
        return;
      }

      const showcasePanels = gsap.utils.toArray('.showcase-panel');
      const pinWrap = document.querySelector('.pin-wrap');
      const pinContainer = document.querySelector('.pin-container');

      if (!showcasePanels.length || !pinWrap) return;

      const isMobile = window.innerWidth <= 768;
      const isRTL = document.documentElement.getAttribute('dir') === 'rtl';

      if (isMobile) {
        if (pinContainer) pinContainer.classList.add('mobile-scroll');
        return;
      }

      // Force the scroll strip to LTR so GSAP's xPercent math stays consistent.
      // The text content inside panels still inherits RTL from its own styling.
      if (isRTL) {
        pinWrap.style.direction = 'ltr';
      }

      let scrollTween = gsap.to(showcasePanels, {
        xPercent: -100 * (showcasePanels.length - 1),
        ease: 'none',
        scrollTrigger: {
          trigger: '.pin-container',
          pin: true,
          scrub: 1,
          snap: 1 / (showcasePanels.length - 1),
          end: () => '+=' + pinWrap.offsetWidth,
        },
      });

      // Parallax on [data-speed] elements inside each panel
      showcasePanels.forEach((panel) => {
        panel.querySelectorAll('[data-speed]').forEach((el) => {
          const speed = parseFloat(el.getAttribute('data-speed'));
          const offset = (1 - speed) * 200;
          gsap.fromTo(
            el,
            { x: offset },
            {
              x: -offset,
              ease: 'none',
              scrollTrigger: {
                trigger: panel,
                containerAnimation: scrollTween,
                start: 'left right',
                end: 'right left',
                scrub: true,
              },
            }
          );
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShowcase);
    } else {
      initShowcase();
    }
  })();
</script>

{% schema %}
{
  "name": "Cinematic Showcase",
  "presets": [
    {
      "name": "Cinematic Showcase",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
