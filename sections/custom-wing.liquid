{{ 'custom-wing.css' | asset_url | stylesheet_tag }}

<!-- WING / FORM SECTION -->
<div class="stats-section" id="stats-section">
  <!-- AMBIENT LAYER -->
  <div class="stats-ambient">
    <div class="stats-orb orb-c"></div>
    <div class="stats-orb orb-m"></div>
    <div class="stats-orb orb-a"></div>
    <div class="stats-grid-lines"></div>
  </div>

  <div class="section-inner">
    <!-- LEFT COLUMN: PRODUCT IMAGE SLIDESHOW -->
    <div class="product-col">
      <div class="decorative-ring"></div>

      <div class="product-wrap">
        <div class="product-tilt" id="stats-product-tilt">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.caption | escape }}" class="wing-img {% if forloop.first %}active{% endif %}" loading="lazy" decoding="async" {{ block.shopify_attributes }} />
              {% else %}
                {% if forloop.index == 1 %}
                  <img src="{{ 'rgb3.png' | asset_url }}" alt="{{ block.settings.caption | escape }}" class="wing-img {% if forloop.first %}active{% endif %}" loading="lazy" decoding="async" {{ block.shopify_attributes }} />
                {% elsif forloop.index == 2 %}
                  <img src="{{ 'rgb2.png' | asset_url }}" alt="{{ block.settings.caption | escape }}" class="wing-img {% if forloop.first %}active{% endif %}" loading="lazy" decoding="async" {{ block.shopify_attributes }} />
                {% else %}
                  <img src="{{ 'rgb1.png' | asset_url }}" alt="{{ block.settings.caption | escape }}" class="wing-img {% if forloop.first %}active{% endif %}" loading="lazy" decoding="async" {{ block.shopify_attributes }} />
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            <img src="{{ 'rgb3.png' | asset_url }}" alt="Wing Position 1" class="wing-img active" loading="lazy" decoding="async" />
            <img src="{{ 'rgb2.png' | asset_url }}" alt="Wing Position 2" class="wing-img" loading="lazy" decoding="async" />
            <img src="{{ 'rgb1.png' | asset_url }}" alt="Wing Position 3" class="wing-img" loading="lazy" decoding="async" />
          {% endif %}
        </div>
        <div class="slideshow-controls justify-center mt-8">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="slide-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></div>
            {% endfor %}
          {% else %}
            <div class="slide-dot active" data-index="0"></div>
            <div class="slide-dot" data-index="1"></div>
            <div class="slide-dot" data-index="2"></div>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: CAPTIONS -->
    <div class="stats-left">
      <div class="stats-eyebrow">
        <div class="eyebrow-line"></div>
        <span>{% if request.locale.iso_code == 'ar' %}مرونة الأجنحة + RGB{% else %}RGB + WING FLEXIBILITY{% endif %}</span>
      </div>

      <div class="wing-captions-container">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <h2 class="wing-caption {% if forloop.first %}active{% endif %}">{{ block.settings.caption }}</h2>
          {% endfor %}
        {% else %}
          <h2 class="wing-caption active">{% if request.locale.iso_code == 'ar' %}شكّل الإضاءة على طريقتك.{% else %}Shape the light your way.{% endif %}</h2>
          <h2 class="wing-caption">{% if request.locale.iso_code == 'ar' %}شكل واحد. أمزجة متعددة.{% else %}One form. Multiple moods.{% endif %}</h2>
          <h2 class="wing-caption">{% if request.locale.iso_code == 'ar' %}اضبط الأجنحة. حوّل المكان.{% else %}Adjust the wings. Transform the space.{% endif %}</h2>
        {% endif %}
      </div>

      <div class="stats-row-container">
        <div class="stat-block" data-target="16">
          <div class="stat-number-wrap">
            <span class="stat-value grad-cyan-magenta">0</span><span class="stat-suffix grad-cyan-magenta">M+</span>
          </div>
          <div class="stat-label">{% if request.locale.iso_code == 'ar' %}ألوان نابضة بالحياة{% else %}VIBRANT COLORS{% endif %}</div>
          <p class="stat-label" style="font-size: 12px; margin-top: 4px; text-transform: none; color: rgba(255, 255, 255, 0.5);">{% if request.locale.iso_code == 'ar' %}١٦ مليون طريقة لضبط الجو{% else %}16 Million ways to set the tone{% endif %}</p>
        </div>

        <div class="stat-block" data-target="200">
          <div class="stat-number-wrap">
            <span class="stat-value solid-cyan">0</span><span class="stat-suffix solid-cyan">+</span>
          </div>
          <div class="stat-label">{% if request.locale.iso_code == 'ar' %}أوضاع إضاءة ديناميكية{% else %}DYNAMIC LIGHTING MODES{% endif %}</div>
          <p class="stat-label" style="font-size: 12px; margin-top: 4px; text-transform: none; color: rgba(255, 255, 255, 0.5);">{% if request.locale.iso_code == 'ar' %}إضاءة ديناميكية، جو لا ينتهي{% else %}Dynamic light, endless atmosphere{% endif %}</p>
        </div>

        <div class="stat-block" data-target="1000">
          <div class="stat-number-wrap">
            <span class="stat-value solid-amber">0</span><span class="stat-suffix solid-amber">lm</span>
          </div>
          <div class="stat-label">{% if request.locale.iso_code == 'ar' %}أقصى ناتج لومن{% else %}PEAK LUMEN OUTPUT{% endif %}</div>
          <p class="stat-label" style="font-size: 12px; margin-top: 4px; text-transform: none; color: rgba(255, 255, 255, 0.5);">{% if request.locale.iso_code == 'ar' %}من توهج خافت إلى انغماس كامل{% else %}From subtle glow to full immersion{% endif %}</p>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- END WING / FORM SECTION -->

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // --- NEW WING / FORM SECTION LOGIC ---
    const wingSection = document.getElementById('stats-section');
    if (wingSection) {
      const wingImages = wingSection.querySelectorAll('.wing-img');
      const wingCaptions = wingSection.querySelectorAll('.wing-caption');
      const slideDots = wingSection.querySelectorAll('.slide-dot');
      let currentSlide = 0;
      let slideInterval;

      function updateSlide(index) {
        if (wingImages.length === 0) return;
        
        let oldActive = -1;
        wingImages.forEach((img, i) => {
           if (img.classList.contains('active')) {
               oldActive = i;
           }
        });

        let isNext = true;
        if (oldActive !== -1) {
           if (index === 0 && oldActive === wingImages.length - 1) isNext = true;
           else if (index === wingImages.length - 1 && oldActive === 0) isNext = false;
           else if (index > oldActive) isNext = true;
           else isNext = false;
        }

        wingImages.forEach((img, i) => {
          img.classList.remove('active', 'slide-left');
          if (wingCaptions[i]) wingCaptions[i].classList.remove('active', 'slide-left');
          if (slideDots[i]) slideDots[i].classList.remove('active');
        });

        if (oldActive !== -1) {
            if (isNext) {
                wingImages[oldActive].classList.add('slide-left');
                if (wingCaptions[oldActive]) wingCaptions[oldActive].classList.add('slide-left');
            }
        }

        if (!isNext) {
            wingImages[index].style.transition = 'none';
            wingImages[index].classList.add('slide-left');
            if (wingCaptions[index]) {
                wingCaptions[index].style.transition = 'none';
                wingCaptions[index].classList.add('slide-left');
            }
            
            void wingImages[index].offsetWidth; // trigger reflow
            
            wingImages[index].style.transition = '';
            wingImages[index].classList.remove('slide-left');
            if (wingCaptions[index]) {
                wingCaptions[index].style.transition = '';
                wingCaptions[index].classList.remove('slide-left');
            }
        }

        wingImages[index].classList.add('active');
        if (wingCaptions[index]) wingCaptions[index].classList.add('active');
        if (slideDots[index]) slideDots[index].classList.add('active');
      }

      function nextSlide() {
        if (wingImages.length === 0) return;
        currentSlide = (currentSlide + 1) % wingImages.length;
        updateSlide(currentSlide);
      }

      function prevSlide() {
        if (wingImages.length === 0) return;
        currentSlide = (currentSlide - 1 + wingImages.length) % wingImages.length;
        updateSlide(currentSlide);
      }

      function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

      // Swipe functionality
      let touchStartX = 0;
      let touchEndX = 0;
      const swipeThreshold = 50;
      const productWrap = wingSection.querySelector('.product-wrap');
      let isDragging = false;
      
      if (productWrap) {
        productWrap.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        productWrap.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        }, { passive: true });
        
        productWrap.addEventListener('mousedown', (e) => {
          isDragging = true;
          touchStartX = e.screenX;
        });
        
        productWrap.addEventListener('mouseup', (e) => {
          if (!isDragging) return;
          isDragging = false;
          touchEndX = e.screenX;
          handleSwipe();
        });
        
        productWrap.addEventListener('mouseleave', () => {
          if (isDragging) {
            isDragging = false;
          }
        });
      }

      function handleSwipe() {
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > swipeThreshold) {
          clearInterval(slideInterval);
          if (diff > 0) {
            nextSlide(); // Swiped left
          } else {
            prevSlide(); // Swiped right
          }
          slideInterval = setInterval(nextSlide, 3500);
        }
      }

      const wingObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (!slideInterval) {
               slideInterval = setInterval(nextSlide, 3500);
            }
            
            const prodCol = wingSection.querySelector('.product-col');
            if (prodCol) prodCol.classList.add('visible');
            
            // Animate stat blocks
            const statBlocks = wingSection.querySelectorAll('.stat-block');
            statBlocks.forEach((block, index) => {
              setTimeout(() => {
                block.classList.add('visible');
              }, index * 150);
              
              const targetStr = block.getAttribute('data-target');
              if (!targetStr) return;
              const target = parseInt(targetStr, 10);
              const valEl = block.querySelector('.stat-value');
              if (!valEl) return;
              
              let startTime = null;
              const duration = 2000;
              
              function updateCounter(currentTime) {
                if (!startTime) startTime = currentTime;
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                
                const currentVal = Math.round(easeOutCubic(progress) * target);
                valEl.textContent = currentVal;
                
                if (progress < 1) {
                  requestAnimationFrame(updateCounter);
                }
              }
              requestAnimationFrame(updateCounter);
            });
            
          } else {
             clearInterval(slideInterval);
             slideInterval = null;
          }
        });
      }, { threshold: 0.15 });
      
      wingObserver.observe(wingSection);

      slideDots.forEach((dot, index) => {
         dot.addEventListener('click', () => {
            clearInterval(slideInterval);
            currentSlide = index;
            updateSlide(currentSlide);
            slideInterval = setInterval(nextSlide, 3500);
         });
      });
    }

    // 3D Tilt Effect on Product Stage
    const productCol = document.querySelector('.product-col');
    const productTilt = document.getElementById('stats-product-tilt');
    
    if (productCol && productTilt && !('ontouchstart' in window)) {
      productCol.addEventListener('mousemove', (e) => {
        const rect = productCol.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        const deltaX = e.clientX - centerX;
        const deltaY = e.clientY - centerY;
        
        const rotateX = (deltaY / rect.height) * -12; // max ±12deg
        const rotateY = (deltaX / rect.width) * 12;
        
        productTilt.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.03)`;
      });
      
      productCol.addEventListener('mouseleave', () => {
        productTilt.style.transform = `perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)`;
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Wing",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Slide caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Wing",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "caption": "Shape the light your way."
          }
        },
        {
          "type": "slide",
          "settings": {
            "caption": "One form. Multiple moods."
          }
        },
        {
          "type": "slide",
          "settings": {
            "caption": "Adjust the wings. Transform the space."
          }
        }
      ]
    }
  ]
}
{% endschema %}
