{{ 'custom-header.css' | asset_url | stylesheet_tag }}

<nav class="hero-navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo-link">
      <img src="{{ 'White Logo Tag copy.png' | asset_url }}" alt="LAMBATY" class="header-logo-img" />
    </a>
    <div class="nav-links">
      <a href="#stats-section">RGB</a>
      <a href="#music">Music</a>
      <a href="#productivity">Productivity</a>
      <a href="#usecases">Setups</a>
      <a href="#engineering">Design</a>
      <a href="#socials">Socials</a>
    </div>
    <div class="nav-right">
      {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
        <input type="hidden" name="locale_code" value="{{ request.locale.iso_code }}">
        <div class="lang-switcher">
          <button type="submit" name="locale_code" value="en" class="lang-btn {% if request.locale.iso_code != 'ar' %}active{% endif %}">EN</button>
          <span class="divider">/</span>
          <button type="submit" name="locale_code" value="ar" class="lang-btn {% if request.locale.iso_code == 'ar' %}active{% endif %}">AR</button>
        </div>
      {%- endform -%}
      <div class="live-badge">
        <div class="live-dot"></div>
        <span>Pre-order open</span>
      </div>
      <button class="nav-cta">Shop Now</button>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Custom Header",
  "settings": []
}
{% endschema %}
