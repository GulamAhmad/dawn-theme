{{ 'custom-header.css' | asset_url | stylesheet_tag }}

<nav class="hero-navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo-link">
      <img src="{{ 'White Logo Tag copy.png' | asset_url }}" alt="LAMBATY" class="header-logo-img" />
    </a>
    <div class="nav-links">
      <a href="#rgb">{% if request.locale.iso_code == 'ar' %}RGB{% else %}RGB{% endif %}</a>
      <a href="#music">{% if request.locale.iso_code == 'ar' %}موسيقى{% else %}MUSIC{% endif %}</a>
      <a href="#productivity">{% if request.locale.iso_code == 'ar' %}إنتاجية{% else %}PRODUCTIVITY{% endif %}</a>
      <a href="#usecases">{% if request.locale.iso_code == 'ar' %}إعدادات{% else %}SETUPS{% endif %}</a>
      <a href="#engineering">{% if request.locale.iso_code == 'ar' %}تصميم{% else %}DESIGN{% endif %}</a>
      <a href="#socials">{% if request.locale.iso_code == 'ar' %}مجتمع{% else %}SOCIALS{% endif %}</a>
    </div>
    <div class="nav-right">
      {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
        <input type="hidden" name="locale_code" value="{{ request.locale.iso_code }}">
        <div class="lang-switcher">
          <button type="submit" name="locale_code" value="en" class="lang-btn {% if request.locale.iso_code != 'ar' %}active{% endif %}">EN</button>
          <span class="divider">/</span>
          <button type="submit" name="locale_code" value="ar" class="lang-btn {% if request.locale.iso_code == 'ar' %}active{% endif %}">AR</button>
        </div>
      {%- endform -%}
      <a href="/pages/contact" class="live-badge" style="text-decoration: none; color: inherit;">
        <div class="live-dot"></div>
        <span>{% if request.locale.iso_code == 'ar' %}اتصل بنا{% else %}CONTACT US{% endif %}</span>
      </a>
      <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}" class="nav-cta" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">{% if request.locale.iso_code == 'ar' %}تسوق الآن{% else %}Shop Now{% endif %}</a>
    </div>
  </div>
</nav>

<!-- Language switcher now submits the form to Shopify natively.
     Arabic must be published in Shopify Admin > Settings > Languages. -->

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop Button Link",
      "info": "Where should the 'Shop Now' button go?"
    }
  ]
}
{% endschema %}
